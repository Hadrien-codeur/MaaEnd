    // ===== 武陵城 4 条预录滑索送货路线 =====
    // 每条 = 步行到起点滑索 → 上索 → 滑行(可多段) → 下索 → 步行到送货 NPC。
    // 由 Go (SeizeDeliveryJobsDepartureAction.runDeliverRoute) 按终点名调用：节点名 = SeizeDeliveryJobsDeliverRoute<Endpoint>。
    // 终点名与 SeizeDeliveryJobsEndpointFilter.json 一致：Owl / MaterialResearchInstitute / Observatory / TechProductionOffice。
    // 下索后不交货，交货由 Go runSubmitEntry（SeizeDeliveryJobsSubmitEntry）负责。
    // 坐标均已实机录入（map02_lv002）。步行段 = NAVMESH(base px 走位) + HEADING(定朝向)，滑索段 = MapTracker 游戏坐标。
    // 状态(2026-07-28)：Observatory / MaterialResearchInstitute / TechProductionOffice 已测通；Owl 待收尾。

    // ---------- 起点滑索步行（4 条路线共用；待加 HEADING 正对滑索架） ----------
    "SeizeDeliveryJobsDeliverWalkToZipline": {
        "desc": "送货-步行到起点滑索架前（4 条路线共用）【C方案：NAVMESH A*(base px) + HEADING 定朝向】",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "MapNavigateAction",
        "custom_action_param": {
            "map_name": "map02_lv002",
            "path": [
                {
                    "action": "NAVMESH",
                    "target": [
                        952.86,
                        1832.75
                    ],
                    "zone_id": "Wuling_Base"
                },
                {
                    "action": "NAVMESH",
                    "target": [
                        961.06,
                        1831.17
                    ],
                    "zone_id": "Wuling_Base"
                },
                {
                    "action": "NAVMESH",
                    "target": [
                        960.78,
                        1830.32
                    ],
                    "zone_id": "Wuling_Base"
                }
                // TODO(2026-07-28 博士明天处理): 加 HEADING 让上索前精准正对滑索架。
                // 缺输入：起点滑索架的 MapTracker 坐标 → 换算 base px 后填 target。
                // { "action": "HEADING", "target": [滑索架 base px x, y], "zone_id": "Wuling_Base" }
            ]
        },
        "focus": {
            "Node.Recognition.Succeeded": "送货-步行到起点滑索[NAVMESH]"
        }
    },

