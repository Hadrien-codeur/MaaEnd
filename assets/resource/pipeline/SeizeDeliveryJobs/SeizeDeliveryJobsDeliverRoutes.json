    // ===== 送货路线独立测试入口（仅调试用，默认关闭，由 SeizeDeliveryJobsTestDeliverObservatory 任务开启） =====
    // 流程：确保回大世界 → 传送武陵城 → 跑取货路线定位到取货点（真实送货起点）→ 跑 Observatory 送货路线 → 停。
    // 全程不做取货/提交识别，仅供博士核对路线与人物落点。
    "SeizeDeliveryJobsTestDeliverObservatoryEntry": {
        "desc": "送货路线测试入口-观测站（仅调试用）",
        "pre_delay": 0,
        "post_delay": 0,
        "next": [
            "[JumpBack]__SeizeDeliveryJobsEnsureInWorld",
            "SeizeDeliveryJobsTestDeliverObservatoryTeleport"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "**送货路线测试开始（观测站）**"
        }
    },
    "SeizeDeliveryJobsTestDeliverObservatoryTeleport": {
        "desc": "送货测试-传送到武陵城仓储节点锚点",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
                "SceneEnterWorldWulingWulingCity5"
            ]
        },
        "post_delay": 0,
        "timeout": 10000,
        "next": [
            "SeizeDeliveryJobsTestDeliverObservatoryRun"
        ]
    },
    "SeizeDeliveryJobsTestDeliverObservatoryRun": {
        "desc": "送货测试-先跑取货路线到取货点，再跑观测站送货路线（跑完即停）",
        "pre_delay": 0,
        "action": "Custom",
        "custom_action": "SubTask",
        "custom_action_param": {
            "sub": [
