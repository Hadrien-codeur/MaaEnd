{
    // 自动送货模式（v2.2）：在调度申请界面点「查看位置」打开地图，OCR「送货点」标签落点判区间确定路线
    // 钩入点：DeliveryJobsInCargoRedistributionBid.next（点查看位置）+ DeliveryJobsBackToDepot.next（回大世界后跳路线）
    // 识别策略（见 CLAUDE.md 第 17 节）：地图缩放与取货点位置固定，仅「送货点」标签随路线移动。
    // 用 roi 把 OCR 限定在各路线「送货点」的 Y 坐标区间内：标签落在哪个区间就命中哪条路线；
    // 都不在（送货点跑出屏幕或地区无配置）则走 NoRouteMatch 安全兜底。

    // ==================== 入口分发：调度申请界面 → 点击「查看位置」按钮 ====================
    "DeliveryJobsSelfDeliverClickViewLocation": {
        "desc": "调度申请界面：识别并点击「查看位置」按钮，打开大地图弹窗",
        "recognition": "OCR",
        // 阶段 2 已填（图D，2560×1440 → pipeline 1280×720 坐标系，显示坐标 ×0.64）：
        // 默认买方（报价最高，列表顶部）那行的「查看位置」按钮区域，限定在顶部一行避免误中下方买方
        "roi": [
            1040,
            150,
            140,
            50
        ],
        "expected": [
            "查看位置",
            "查看位置",
            "(?i)View\\s*Location",
            "位置を確認",
            "위치 확인"
        ],
        "action": "Click",
        "post_wait_freezes": 200,
        "timeout": 10000,
        "next": [
            "DeliveryJobsSelfDeliverMapDispatch"
        ],
        "on_error": [
            "DeliveryJobsSelfDeliverNoRouteMatch"
        ]
    },

    // ==================== 地图弹窗：按「送货点」标签坐标落点分发到具体路线 ====================
    "DeliveryJobsSelfDeliverMapDispatch": {
        "desc": "地图弹窗：依次用各路线的「送货点」坐标区间 OCR 节点判路线，全不中走 NoRouteMatch 兜底",
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "DeliveryJobsSelfDeliverCheckRouteOriginiumScienceParkA",
            "DeliveryJobsSelfDeliverCheckRouteOriginiumScienceParkB",
            "DeliveryJobsSelfDeliverCheckRouteOriginiumScienceParkC",
            "DeliveryJobsSelfDeliverNoRouteMatch"
        ]
    },
    // 识别方式：ColorMatch 橙色「送货点」标签（会话 8/9 决定，抗边缘变暗；OCR 在地图散布橙色传送点图标场景也可用，但统一用颜色）
    // roi 来源：会话 9 量图（2560×1440 → 1280×720，显示宽 2000 × 0.64）
    //   路线 A 送货点游戏中心 (725, 371) → roi y 区间 348–394
    //   路线 B 送货点游戏中心 (655, 522) → roi y 区间 500–546，与 A 留 ~106px 缓冲带不重叠
    // ⚠ lower/upper/count 是估计值，必须对真实截图像素调（跑日志看匹配像素数后收紧，避免误中橙色传送点图标）
    "DeliveryJobsSelfDeliverCheckRouteOriginiumScienceParkA": {
        "desc": "源石研究园 路线 A（醇化物工厂以外/右中部目的地）：ColorMatch 橙色「送货点」标签，roi 限定路线 A 坐标区间；命中即判本路线",
        "recognition": "ColorMatch",
        "roi": [
            676,
            348,
            100,
            46
        ],
        "lower": [
            200,
            90,
            0
        ],
        "upper": [
            255,
            180,
            80
        ],
        "connected": true,
        "count": 30,
        "action": "DoNothing",
        // 命中后把 PickupEntrance 锚定到路线 A 的起点，关地图后由 PickupStart 跳过去
        "anchor": {
            "DeliveryJobsSelfDeliverPickupEntrance": "DeliveryJobsSelfDeliverOriginiumScienceParkRouteAPickupStart"
        },
        // 【空跑验证临时接线（会话 9）】命中先不接单：跳 VerifyRouteHit（ESC 关地图 + StopTask），看日志哪个 CheckRoute 命中。
        // 验证 A/B 各自命中且不误中后，删 VerifyRouteHit，把本 next 改回 ["DeliveryJobsSelfDeliverCloseMapAndStartDelivery"]
        "next": [
            "DeliveryJobsSelfDeliverVerifyRouteHit"
        ]
    },
    "DeliveryJobsSelfDeliverCheckRouteOriginiumScienceParkB": {
        "desc": "源石研究园 路线 B（醇化物工厂）：ColorMatch 橙色「送货点」标签，roi 限定路线 B 坐标区间；命中即判本路线",
        "recognition": "ColorMatch",
        "roi": [
            604,
            500,
            104,
            46
        ],
        "lower": [
            200,
            90,
            0
        ],
        "upper": [
            255,
            180,
            80
        ],
        "connected": true,
        "count": 30,
        "action": "DoNothing",
        // TODO：路线 B 的取货/送货流程文件尚未建（SelfDeliver/OriginiumSciencePark.json 仅有 RouteA）。
        // 空跑验证阶段不接单、不走 anchor，此处指向待建节点不影响验证。
        "anchor": {
            "DeliveryJobsSelfDeliverPickupEntrance": "DeliveryJobsSelfDeliverOriginiumScienceParkRouteBPickupStart"
        },
        "next": [
            "DeliveryJobsSelfDeliverVerifyRouteHit"
        ]
    },
    // 路线 C：会话 11 用真实 1280×720 截图标定（非 2K 估算）。
    // 送货点橙色标签游戏 box (180,258)~(225,279)，中心 (202,268)，屏幕左上偏中。
    // roi y 区间 248–294，与 A(348–394)、B(500–546) 不重叠。颜色阈值与 A/B 相同（实测 avg RGB(238,109,1)，roi 内 431 橙色像素 ≫ count 30）。
    "DeliveryJobsSelfDeliverCheckRouteOriginiumScienceParkC": {
        "desc": "源石研究园 路线 C（会话 11 实测目的地，左上偏中）：ColorMatch 橙色「送货点」标签，roi 限定路线 C 坐标区间；命中即判本路线",
        "recognition": "ColorMatch",
        "roi": [
            165,
            248,
            80,
            46
        ],
        "lower": [
            200,
            90,
            0
        ],
        "upper": [
            255,
            180,
            80
        ],
        "connected": true,
        "count": 30,
        "action": "DoNothing",
        // TODO：路线 C 的取货/送货流程文件尚未建（送货路线留空，后续录制再补）。
        // 空跑验证阶段不接单、不走 anchor，此处指向待建节点不影响验证。
        "anchor": {
            "DeliveryJobsSelfDeliverPickupEntrance": "DeliveryJobsSelfDeliverOriginiumScienceParkRouteCPickupStart"
        },
        "next": [
            "DeliveryJobsSelfDeliverVerifyRouteHit"
        ]
    },

    // ==================== 【空跑验证临时节点（会话 9）】命中路线后不接单，只关地图 + StopTask ====================
    // 目的：填入真 roi 后第一次脱离零道具安全网前，先确认 ColorMatch 落点分发正确（A 图命中 CheckRouteA、B 图命中 CheckRouteB，且不误中橙色传送点图标）。
    // 验证通过后整组删除，各 CheckRoute.next 改回 DeliveryJobsSelfDeliverCloseMapAndStartDelivery。
    "DeliveryJobsSelfDeliverVerifyRouteHit": {
        "desc": "【空跑验证临时】命中某路线后 ESC 关地图，不接单。日志里上一个命中的 CheckRoute 节点名即所判路线",
        "recognition": "DirectHit",
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27 // ESC
            }
        },
        "post_wait_freezes": 200,
        "next": [
            "DeliveryJobsSelfDeliverStopForVerify"
        ]
    },
    "DeliveryJobsSelfDeliverStopForVerify": {
        "desc": "【空跑验证临时】StopTask，零道具消耗。看日志确认哪条 CheckRoute 命中后再翻正式接单",
        "recognition": "DirectHit",
        "action": "StopTask"
    },

    // ==================== 命中路线后：关闭地图 → 回到调度申请界面 → 让原流程继续点开始运送 ====================
    "DeliveryJobsSelfDeliverCloseMapAndStartDelivery": {
        "desc": "ESC 关闭地图弹窗，回到调度申请界面，由原流程继续点击「开始运送」",
        "recognition": "DirectHit",
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27 // ESC
            }
        },
        "post_wait_freezes": 200,
        "next": [
            "DeliveryJobsRedistributionBidNextStep"
        ]
    },

    // ==================== 兜底：未匹配到任何路线 ====================
    "DeliveryJobsSelfDeliverNoRouteMatch": {
        "desc": "调度申请界面或地图弹窗未匹配到已配置路线，关闭地图后停止任务（避免误接单）",
        "recognition": "DirectHit",
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 27 // ESC
            }
        },
        "post_wait_freezes": 200,
        "next": [
            "DeliveryJobsSelfDeliverStopForNoRouteMatch"
        ]
    },
    "DeliveryJobsSelfDeliverStopForNoRouteMatch": {
        "desc": "正式 StopTask（提示文案）",
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {
            "Node.Recognition.Succeeded": "$task.DeliveryJobs.SelfDeliverMode.NoRouteMatch"
        }
    },

    // ==================== 装货完回大世界后：通过 anchor 跳到对应路线 ====================
    "DeliveryJobsSelfDeliverPickupStart": {
        "desc": "自动送货：装货完回到大世界后，通过 anchor 跳到匹配到的路线起点",
        "recognition": "And",
        "all_of": [
            "InWorld"
        ],
        "next": [
            "[Anchor]DeliveryJobsSelfDeliverPickupEntrance",
            "DeliveryJobsSelfDeliverNoRoute"
        ]
    },
    "DeliveryJobsSelfDeliverNoRoute": {
        "desc": "anchor 没匹配到任何路线起点（理论上不会到这里），停止任务",
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": {
            "Node.Recognition.Succeeded": "$task.DeliveryJobs.SelfDeliverMode.NoRoute"
        }
    },

    // ==================== 流程结束 ====================
    "DeliveryJobsSelfDeliverEnd": {
        "desc": "自动送货完成，停止任务",
        "recognition": "DirectHit",
        "action": "StopTask"
    }
}
