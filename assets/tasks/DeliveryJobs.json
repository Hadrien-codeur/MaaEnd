{
    "task": [
        {
            "name": "DeliveryJobs",
            "label": "$task.DeliveryJobs.label",
            "entry": "DeliveryJobsMain",
            "description": "$task.DeliveryJobs.description",
            "option": [
                "ValleyIV",
                "Wuling",
                "PackCargoSelectItem",
                "DeliveryJobsAcceptJobOnly",
                "DeliveryJobsPackCargoOnly",
                "DeliveryJobsAutoDeliver"
            ],
            "controller": [
                "ADB",
                "CloudADB",
                "MacOS-Background",
                "MacOS-Front",
                "PlayCover",
                "Win32-Front",
                "Wlroots"
            ],
            "group": [
                "regional_development"
            ]
        }
    ],
    "option": {
        "ValleyIV": {
            "type": "switch",
            "label": "$global.region.ValleyIV",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DeliveryJobsValleyIV": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "OriginiumSciencePark",
                        "OriginLodespring",
                        "PowerPlateau"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DeliveryJobsValleyIV": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "OriginiumSciencePark": {
            "type": "switch",
            "label": "$global.region.OriginiumSciencePark",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DeliveryJobsEnterOriginiumScienceParkCargo": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DeliveryJobsEnterOriginiumScienceParkCargo": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "OriginLodespring": {
            "type": "switch",
            "label": "$global.region.OriginLodespring",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DeliveryJobsEnterOriginLodespringCargo": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DeliveryJobsEnterOriginLodespringCargo": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "PowerPlateau": {
            "type": "switch",
            "label": "$global.region.PowerPlateau",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DeliveryJobsEnterPowerPlateauCargo": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DeliveryJobsEnterPowerPlateauCargo": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "Wuling": {
            "type": "switch",
            "label": "$global.region.Wuling",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DeliveryJobsWuling": {
                            "enabled": true
                        }
                    },
                    "option": [
                        "WulingCity",
                        "TestArea"
                    ]
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DeliveryJobsWuling": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "WulingCity": {
            "type": "switch",
            "label": "$global.region.WulingCity",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DeliveryJobsEnterWulingCityCargo": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DeliveryJobsEnterWulingCityCargo": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "TestArea": {
            "type": "switch",
            "label": "$global.region.TestArea",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DeliveryJobsEnterTestAreaCargo": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "DeliveryJobsEnterTestAreaCargo": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "PackCargoSelectItem": {
            "type": "switch",
            "label": "$task.DeliveryJobs.PackCargoSelectItem.label",
            "description": "$task.DeliveryJobs.PackCargoSelectItem.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "DeliveryJobsSelectTypeOfGoodsToPackNextStep": {
                            "next": [
                                "DeliveryJobsSelectItemLoop"
                            ]
                        }
                    },
                    "option": [
                        "WhatToFillValleyIV",
                        "WhatToFillWuling"
                    ]
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "WhatToFillValleyIV": {
            "type": "select",
            "label": "$task.DeliveryJobs.WhatToFillValleyIV",
            "cases": [
                {
                    "name": "砂叶粉末",
                    "label": "$item.SandleafPowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillValleyIV": {
                            "template": "DeliveryJobs/SandleafPowder.png"
                        }
                    }
                },
                {
                    "name": "荞花粉末",
                    "label": "$item.BuckflowerPowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillValleyIV": {
                            "template": "DeliveryJobs/BuckflowerPowder.png"
                        }
                    }
                },
                {
                    "name": "柑实粉末",
                    "label": "$item.CitromePowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillValleyIV": {
                            "template": "DeliveryJobs/CitromePowder.png"
                        }
                    }
                },
                {
                    "name": "酮化灌木粉末",
                    "label": "$item.AketinePowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillValleyIV": {
                            "template": "DeliveryJobs/AketinePowder.png"
                        }
                    }
                }
            ],
            "default_case": "砂叶粉末"
        },
        "WhatToFillWuling": {
            "type": "select",
            "label": "$task.DeliveryJobs.WhatToFillWuling",
            "cases": [
                {
                    "name": "砂叶粉末",
                    "label": "$item.SandleafPowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/SandleafPowder.png"
                        }
                    }
                },
                {
                    "name": "荞花粉末",
                    "label": "$item.BuckflowerPowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/BuckflowerPowder.png"
                        }
                    }
                },
                {
                    "name": "柑实粉末",
                    "label": "$item.CitromePowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/CitromePowder.png"
                        }
                    }
                },
                {
                    "name": "酮化灌木粉末",
                    "label": "$item.AketinePowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/AketinePowder.png"
                        }
                    }
                },
                {
                    "name": "芽针粉末",
                    "label": "$item.YazhenPowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/YazhenPowder.png"
                        }
                    }
                },
                {
                    "name": "锦草粉末",
                    "label": "$item.JincaoPowder",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/JincaoPowder.png"
                        }
                    }
                },
                {
                    "name": "芽针",
                    "label": "$item.Yazhen",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/Yazhen.png"
                        }
                    }
                },
                {
                    "name": "锦草",
                    "label": "$item.Jincao",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/Jincao.png"
                        }
                    }
                },
                {
                    "name": "息壤",
                    "label": "$item.Xiranite",
                    "pipeline_override": {
                        "DeliveryJobsSelectItemToFillWuling": {
                            "template": "DeliveryJobs/Xiranite.png"
                        }
                    }
                }
            ],
            "default_case": "砂叶粉末"
        },
        "DeliveryJobsAcceptJobOnly": {
            "type": "switch",
            "label": "$task.DeliveryJobs.AcceptJobOnly.label",
            "description": "$task.DeliveryJobs.AcceptJobOnly.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        // 确保不会进入送货任务，从而避免点击转交按钮
                        "DeliveryJobsEnterOriginiumScienceParkDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsEnterOriginLodespringDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsEnterPowerPlateauDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsEnterWulingCityDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsEnterTestAreaDeliveryJob": {
                            "enabled": false
                        },
                        // 回到大世界后直接停止任务，不继续后续流程
                        "DeliveryJobsBackToDepot": {
                            "next": [
                                "DeliveryJobsAcceptJobOnly"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "DeliveryJobsPackCargoOnly": {
            "type": "switch",
            "label": "$task.DeliveryJobs.PackCargoOnly.label",
            "description": "$task.DeliveryJobs.PackCargoOnly.description",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        // 确保不会进入送货任务，从而避免点击转交按钮
                        "DeliveryJobsEnterOriginiumScienceParkDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsEnterOriginLodespringDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsEnterPowerPlateauDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsEnterWulingCityDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsEnterTestAreaDeliveryJob": {
                            "enabled": false
                        },
                        "DeliveryJobsInCargoRedistributionBid": {
                            "next": [
                                "DeliveryJobsBackToDepotFromBid"
                            ]
                        },
                        "DeliveryJobsCheckOriginiumScienceParkCargo": {
                            "expected": [
                                "货物装箱",
                                "貨物裝箱",
                                "(?i)Pack\\s*Goods",
                                "パッキング",
                                "화물 포장"
                            ]
                        },
                        "DeliveryJobsCheckOriginLodespringCargo": {
                            "expected": [
                                "货物装箱",
                                "貨物裝箱",
                                "(?i)Pack\\s*Goods",
                                "パッキング",
                                "화물 포장"
                            ]
                        },
                        "DeliveryJobsCheckPowerPlateauCargo": {
                            "expected": [
                                "货物装箱",
                                "貨物裝箱",
                                "(?i)Pack\\s*Goods",
                                "パッキング",
                                "화물 포장"
                            ]
                        },
                        "DeliveryJobsCheckWulingCityCargo": {
                            "expected": [
                                "货物装箱",
                                "貨物裝箱",
                                "(?i)Pack\\s*Goods",
                                "パッキング",
                                "화물 포장"
                            ]
                        },
                        "DeliveryJobsCheckTestAreaCargo": {
                            "expected": [
                                "货物装箱",
                                "貨物裝箱",
                                "(?i)Pack\\s*Goods",
                                "パッキング",
                                "화물 포장"
                            ]
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        },
        "DeliveryJobsAutoDeliver": {
            "type": "switch",
            "label": "$task.DeliveryJobs.AutoDeliver.label",
            "description": "$task.DeliveryJobs.AutoDeliver.description",
            // 自动送货依赖 MapTracker / MapNavigator，仅这两个控制器可用
            "controller": [
                "Win32-Front",
                "Wlroots"
            ],
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        // 1) 打开本任务的自动送货接线节点
                        "DeliveryJobsAutoDeliverEntry": {
                            "enabled": true
                        },
                        "DeliveryJobsAutoDeliverDone": {
                            "enabled": true
                        },
                        "DeliveryJobsAutoDeliverUnsupported": {
                            "enabled": true
                        },
                        "DeliveryJobsAutoDeliverEnterDestinationMap": {
                            "enabled": true
                        },
                        "DeliveryJobsAutoDeliverViewJob": {
                            "enabled": true
                        },
                        "DeliveryJobsAutoDeliverViewDestinationMap": {
                            "enabled": true
                        },
                        "DeliveryJobsAutoDeliverStartTrackingTask": {
                            "enabled": true
                        },
                        "DeliveryJobsAutoDeliverInDestinationMap": {
                            "enabled": true
                        },
                        // 1.5) 自己装箱产生的委托不会出现在「运送委托列表」中，改从本地仓储节点的
                        //      「查看任务」进入。此处一并拦下该节点的全部三次调用
                        //      （传送前、取消任务追踪前、送货前）。
                        "SeizeDeliveryJobsEnterDestinationMap": {
                            "next": [
                                "DeliveryJobsAutoDeliverEnterDestinationMap"
                            ]
                        },
                        // 2) 打开抢委托送货的整条后处理链路（取货 → 送货 → 提交）
                        "SeizeDeliveryJobsPostProcessingEntry": {
                            "enabled": true
                        },
                        "SeizeDeliveryJobsPrepareFetchGoods": {
                            "enabled": true
                        },
                        "SeizeDeliveryJobsPostDepartureEntry": {
                            "enabled": true
                        },
                        // 3) 送货段只走预录的固定滑索路线，不匹配即失败（不回退寻路）
                        "SeizeDeliveryJobsRunDeparture": {
                            "custom_action_param": {
                                "map_name_regex": "^map02_lv002$", // 目前仅武陵城已录制固定路线
                                "zipline_policy": "Lazy", // 命中固定路线时不使用此值；仅参数校验需要
                                "is_retry": false,
                                "custom_delivery": true
                            }
                        },
                        // 4) 提交货物并关闭奖励框后，回到本任务收尾，而非跳去抢委托的抢单入口
                        "SeizeDeliveryJobsCloseRewardDialog": {
                            "next": [
                                "DeliveryJobsAutoDeliverDone"
                            ]
                        },
                        // 5) 装箱完回到大世界时，按地区 anchor 决定是自己送还是提示不支持
                        "DeliveryJobsBackToDepot": {
                            "next": [
                                "[Anchor]DeliveryJobsAutoDeliverAfterPack",
                                "[Anchor]DeliveryJobsGoToDepot"
                            ]
                        },
                        // 6) 任务开始时手上已有单（仓储节点显示「查看任务」）：不转交，改为自己送
                        "DeliveryJobsEnterWulingCityDeliveryJob": {
                            "next": [
                                "DeliveryJobsAutoDeliverEntry"
                            ]
                        },
                        "DeliveryJobsEnterTestAreaDeliveryJob": {
                            "next": [
                                "DeliveryJobsAutoDeliverUnsupported"
                            ]
                        },
                        "DeliveryJobsEnterOriginiumScienceParkDeliveryJob": {
                            "next": [
                                "DeliveryJobsAutoDeliverUnsupported"
                            ]
                        },
                        "DeliveryJobsEnterOriginLodespringDeliveryJob": {
                            "next": [
                                "DeliveryJobsAutoDeliverUnsupported"
                            ]
                        },
                        "DeliveryJobsEnterPowerPlateauDeliveryJob": {
                            "next": [
                                "DeliveryJobsAutoDeliverUnsupported"
                            ]
                        },
                        // 7) 进入某地区装箱时，同时锚定装箱完成后的去向
                        "DeliveryJobsEnterWulingCityCargo": {
                            "anchor": {
                                "DeliveryJobsSelectItemToFill": "DeliveryJobsSelectItemToFillWuling",
                                "DeliveryJobsAutoDeliverAfterPack": "DeliveryJobsAutoDeliverEntry"
                            }
                        },
                        "DeliveryJobsEnterTestAreaCargo": {
                            "anchor": {
                                "DeliveryJobsSelectItemToFill": "DeliveryJobsSelectItemToFillWuling",
                                "DeliveryJobsAutoDeliverAfterPack": "DeliveryJobsAutoDeliverUnsupported"
                            }
                        },
                        "DeliveryJobsEnterOriginiumScienceParkCargo": {
                            "anchor": {
                                "DeliveryJobsSelectItemToFill": "DeliveryJobsSelectItemToFillValleyIV",
                                "DeliveryJobsAutoDeliverAfterPack": "DeliveryJobsAutoDeliverUnsupported"
                            }
                        },
                        "DeliveryJobsEnterOriginLodespringCargo": {
                            "anchor": {
                                "DeliveryJobsSelectItemToFill": "DeliveryJobsSelectItemToFillValleyIV",
                                "DeliveryJobsAutoDeliverAfterPack": "DeliveryJobsAutoDeliverUnsupported"
                            }
                        },
                        "DeliveryJobsEnterPowerPlateauCargo": {
                            "anchor": {
                                "DeliveryJobsSelectItemToFill": "DeliveryJobsSelectItemToFillValleyIV",
                                "DeliveryJobsAutoDeliverAfterPack": "DeliveryJobsAutoDeliverUnsupported"
                            }
                        }
                    }
                },
                {
                    "name": "No"
                }
            ],
            "default_case": "No"
        }
    }
}
