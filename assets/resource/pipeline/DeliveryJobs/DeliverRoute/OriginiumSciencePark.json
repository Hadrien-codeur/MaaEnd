{
    // 源石研究园送货路线
    // 路线数据需用 MapNavigator 工具录制后填入对应 TODO 位置
    "DeliveryJobsDeliverRouteOriginiumScienceParkStart": {
        "desc": "源石研究园送货路线：起始节点",
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsDeliverRouteOriginiumScienceParkAssertLocation"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "开始源石研究园送货路线"
        }
    },
    "DeliveryJobsDeliverRouteOriginiumScienceParkAssertLocation": {
        // TODO: 用 MapNavigator 的 Assert 模式框选送货起点（通常是接完任务后角色出现的位置）后导出 zone_id 和 target
        "desc": "断言：验证角色当前位置在源石研究园地图上",
        "recognition": "Custom",
        "custom_recognition": "MapLocateAssertLocation",
        "custom_recognition_param": {
            "zone_id": "TODO_FILL_ZONE_ID",
            "target": [
                0,
                0,
                20,
                20
            ]
        },
        "action": "DoNothing",
        "timeout": 20000,
        "next": [
            "DeliveryJobsDeliverRouteOriginiumScienceParkGoto"
        ],
        "on_error": [
            "DeliveryJobsDeliverRouteEnd"
        ]
    },
    "DeliveryJobsDeliverRouteOriginiumScienceParkGoto": {
        // TODO: 用 MapNavigator 录制完整路线后，将导出的 path 数组复制粘贴到下方 path 中
        // path 中如有滑索/交互点，对应坐标用 "INTERACT" 标记，例如 [123, 456, "INTERACT"]
        // 如需点击"自动滑行"等按钮，在本节点 next 前追加独立的 OCR/TemplateMatch + Click 节点
        "desc": "源石研究园送货路线：导航至送货目的地",
        "max_hit": 1,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "MapNavigateAction",
                "custom_action_param": {
                    "path": []
                }
            }
        },
        "timeout": 600000,
        "next": [
            "DeliveryJobsDeliverRouteOriginiumScienceParkDeliver",
            "DeliveryJobsDeliverRouteEnd"
        ],
        "on_error": [
            "DeliveryJobsDeliverRouteEnd"
        ]
    },
    "DeliveryJobsDeliverRouteOriginiumScienceParkDeliver": {
        // TODO: 根据目的地交付 UI，补充识别和点击逻辑
        // 推荐做法：用 OCR 识别交付按钮文本（如"交付"/"送达"），或用 TemplateMatch 匹配按钮图片
        // 完成识别后将本节点的 action 改为 Click 并添加 next
        "desc": "源石研究园送货路线：到达目的地后完成送货交互",
        "pre_delay": 0,
        "action": "DoNothing",
        "post_delay": 0,
        "timeout": 30000,
        "rate_limit": 0,
        "next": [
            "DeliveryJobsDeliverRouteEnd"
        ],
        "on_error": [
            "DeliveryJobsDeliverRouteEnd"
        ]
    }
