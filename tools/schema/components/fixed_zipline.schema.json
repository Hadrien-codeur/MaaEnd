{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "NavigateParam": {
            "if": {
                "type": "object",
                "required": ["fixed_zipline_route"]
            },
            "then": {
                "required": ["path", "zip"],
                "properties": {
                    "fixed_zipline_route": {"type": "string", "pattern": "\\S"},
                    "zip": {"const": true},
                    "path": {"type": "array", "minItems": 1}
                }
            }
        }
    }
}
